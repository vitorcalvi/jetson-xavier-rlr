# rlr.env.example -- user-level RLR runtime tunables for the Jetson install.
#
# Copy this template to ~/.config/rlr/rlr.env and edit for your host; the unit
# loads it through `EnvironmentFile=-%h/.config/rlr/rlr.env`. The driver resolves
# data/kill/heartbeat paths from the user's $HOME by default, so only
# advisory-tier tunables are listed here. The deterministic loop runs without a
# model; the falcon06 advisor is advisory only and never the final selector, so
# RLR_ADVISOR_ENABLE=0 keeps the loop independent of the model server.
#
# The committed values below are safe, non-secret defaults. Never commit a
# credential here. The live ~/.config/rlr/rlr.env may contain the dedicated
# RLR_LAN_LLM_API_KEY and must remain chmod 600.
#
# Install the runtime WITH the signing extra, or the loop refuses to start:
#   python3 -m pip install -e .[crypto]
# Without `cryptography` the runtime cannot verify a signed mission policy, so a
# deployment that configures ENFORCE (below) fails loudly at startup instead of
# silently governing itself in OBSERVATION_ONLY.

# Seconds between closed-loop ticks.
RLR_TICK_SECONDS=1.0

# 1 enables the advisory slow brain reached over the loopback; 0 disables it.
RLR_ADVISOR_ENABLE=0

# Advisor model name and OpenAI-compatible base URL (loopback only).
RLR_MODEL_NAME=falcon06
RLR_LLAMA_BASE_URL=http://127.0.0.1:8080
# Sized to measured latency, not a guess: falcon06 on the Jetson answers
# ~3.0 s p50 / ~3.2 s p95 unloaded, so the previous 1.5 s could never succeed
# even on an idle host and the advisor timed out on every tick. 15 s leaves ~4x
# headroom over the unloaded p95 for the residual contention that remains once
# rlr-simsoak.service is deprioritized. The loop still ticks on 1 s and never
# blocks on this: a timeout degrades to abstain, it does not stall the loop.
RLR_QWEN_TIMEOUT_SECONDS=15
# The advice reply is grammar-bounded to the candidate enum plus a rationale of
# at most 40 characters and generation stops at the closing brace, so 121 tokens
# always reaches a complete, parseable object: the worst case of one token per
# character of the longest valid object (105 characters) plus 16 of slack.
# Do not shrink this: a budget the grammar can exceed truncates the reply and
# the advisor falls back to abstain on most ticks. Do not raise it either: an
# unbounded budget is exactly what made the advisor miss the deadline.
RLR_QWEN_MAX_TOKENS=121

# Required production G1 authority. The signed envelope and public PEM are
# non-secret; the Ed25519 private key stays on the trusted operator host only.
# agent_runtime preflights scope, finite budgets and signed expiry, then the
# kernel independently re-verifies the same files and the digests must match.
RLR_POLICY_PATH=/home/vitor/.config/rlr/self-maintenance.policy.json
RLR_POLICY_PUBLIC_KEY_PATH=/home/vitor/.config/rlr/operator-public.pem

# Required hard per-run PID cap for production ENFORCE. Missing/empty fails
# startup unless RLR_SANDBOX_PIDS_CGROUP_EXEMPT=1 is explicitly approved,
# with a loud warning and no kernel cgroup PID cap. Every run gets its own
# capped child cgroup under this base and agent_runtime refuses to start if the
# directory is missing or not writable. Created and chowned to this user by the
# system unit: sudo systemctl enable --now rlr-sandbox-cgroup.service
RLR_SANDBOX_PIDS_CGROUP=/sys/fs/cgroup/pids/rlr-sandbox
RLR_SANDBOX_PIDS_CGROUP_EXEMPT=0

# Optional LAN escalation. The runtime first uses rules and falcon06; only
# low-confidence/failed advisory cases may reach LiteLLM. Disabled by default.
RLR_LAN_LLM_ENABLE=0
RLR_LAN_LLM_BASE_URL=http://192.168.1.45:4000/v1
RLR_LAN_LLM_MODEL=g1-maintenance
RLR_LAN_LLM_TIMEOUT_SECONDS=1.5
RLR_LAN_LLM_MAX_TOKENS=768
RLR_LAN_ESCALATION_THRESHOLD=0.55

# Secret: set ONLY in ~/.config/rlr/rlr.env (chmod 600). Never commit a value.
RLR_LAN_LLM_API_KEY=